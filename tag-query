#!/usr/bin/env fish
source (dirname (status filename))/tag-common.fish

# 1. 解析参数
set -l and_tags
set -l or_tags
set -l not_tags
set -l mode and

for arg in $argv
    switch $arg
        case '+'
            set mode or
        case -
            set mode not
        case '*'
            switch $mode
                case and
                    set -a and_tags $arg
                case or
                    set -a or_tags $arg
                case not
                    set -a not_tags $arg
            end
    end
end

# 2. 全部为空
if [ (count $and_tags) -eq 0 ]; and [ (count $or_tags) -eq 0 ]; and [ (count $not_tags) -eq 0 ]
    __tag_resources_of $TAG_ROOT/$TAG_DIR
    exit 0
end

# 3. 构建候选集：有 OR → 并集；无 OR → 全部资源
set candidates (mktemp)
if [ (count $or_tags) -gt 0 ]
    for tag in $or_tags
        __tag_resources_of $tag
    end | sort -u >$candidates
else

    __tag_resources_of $TAG_ROOT/$TAG_DIR >$candidates
end

# 4. AND 逐层筛
for tag in $and_tags
    __tag_resources_of $tag | comm -12 $candidates - >$candidates.new
    mv $candidates.new $candidates
end

# 5. NOT 逐层筛
for tag in $not_tags
    __tag_resources_of $tag | comm -23 $candidates - >$candidates.new
    mv $candidates.new $candidates
end

__list (cat $candidates)
rm -f $candidates
